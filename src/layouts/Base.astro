---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { profile, href } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  schema?: Record<string, unknown>[];
  solidHeader?: boolean;
}

const {
  title,
  description = profile.description,
  image = href('/og.jpg'),
  type = 'website',
  schema = [],
  solidHeader = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${profile.name}` : profile.title;
const path = Astro.url.pathname;
const canonical = new URL(path.endsWith('/') || path.includes('.') ? path : `${path}/`, Astro.site);
const ogImage = new URL(image, Astro.site);
const nav = [
  { label: 'Work', path: '/#work' },
  { label: 'About', path: '/#about' },
  { label: 'Photos', path: '/photos/' },
  { label: 'Journal', path: '/journal/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#07080a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A hand framing the sun against a dark sky, with the words Good websites don’t happen by accident." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class:list={['site-header', { solid: solidHeader }]}>
      <nav class="wrap nav" aria-label="Main">
        <a class="brand" href={href('/')}><span class="brand-dot" aria-hidden="true"></span>{profile.name}</a>
        <ul class="nav-links">
          {nav.map((n) => <li><a href={href(n.path)}>{n.label}</a></li>)}
          <li><a class="nav-cta" href={href('/#contact')}>Contact</a></li>
        </ul>
        <details class="nav-mobile">
          <summary aria-label="Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 9h16M4 15h16"></path></svg>
          </summary>
          <ul>
            {nav.map((n) => <li><a href={href(n.path)}>{n.label}</a></li>)}
            <li><a href={href('/#contact')}>Contact</a></li>
          </ul>
        </details>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {profile.name} · {profile.location.label} · Photos by Narada</span>
        <span class="footer-links">
          <a href={`mailto:${profile.email}`}>Email</a>
          <a href={href(profile.cv)} download>CV (PDF)</a>
          <a href={profile.links.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
          <a href={profile.links.github} rel="me noopener" target="_blank">GitHub</a>
        </span>
      </div>
    </footer>

    <script>
      import '../scripts/effects';
    </script>
  </body>
</html>
