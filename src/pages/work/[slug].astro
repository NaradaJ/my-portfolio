---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { profile, href } from '../../data/site';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const site = Astro.site!;
const pageUrl = new URL(href(`/work/${entry.id}/`), site).href;
const homeUrl = new URL(href('/'), site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': d.repo ? 'SoftwareSourceCode' : 'CreativeWork',
    name: d.title,
    description: d.summary,
    url: pageUrl,
    dateCreated: String(d.year),
    author: { '@type': 'Person', '@id': `${homeUrl}#person`, name: profile.name, url: homeUrl },
    keywords: d.stack.join(', '),
    ...(d.repo ? { codeRepository: d.repo, programmingLanguage: d.stack[0] } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: 'Work', item: `${homeUrl}#work` },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
    ],
  },
];
---
<Base title={d.title} description={d.summary} type="article" schema={schema} solidHeader>
  <article class="wrap case">
    <nav aria-label="Breadcrumb" class="crumbs">
      <a href={href('/')}>Home</a><span aria-hidden="true">/</span><a href={href('/#work')}>Work</a><span aria-hidden="true">/</span><span aria-current="page">{d.ticket}</span>
    </nav>

    <header class="case-head">
      <p class="eyebrow">{d.ticket} · {d.kind}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <dl class="facts">
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Year</dt><dd>{d.year}</dd></div>
        <div><dt>Stack</dt><dd>{d.stack.join(' · ')}</dd></div>
      </dl>
      <div class="links">
        {d.live && <a class="btn btn-primary" href={d.live} target="_blank" rel="noopener">View live site</a>}
        {d.repo && <a class:list={['btn', d.live ? 'btn-ghost' : 'btn-primary']} href={d.repo} target="_blank" rel="noopener">View code on GitHub</a>}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <a class="next" href={href(`/work/${next.id}/`)}>
      <span class="eyebrow">Next project</span>
      <span class="next-title">{next.data.title} →</span>
    </a>
  </article>
</Base>

<style>
  .case { max-width: 860px; padding-block: 48px 120px; }
  .crumbs { display: flex; gap: 10px; font-family: var(--mono); font-size: 13px; color: var(--dim); margin-bottom: 48px; }
  .crumbs a { color: var(--fog-3); text-underline-offset: 4px; }
  .case-head { display: flex; flex-direction: column; gap: 20px; padding-bottom: 48px; border-bottom: 1px solid var(--wire); }
  .case-head h1 { font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1.05; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin: 12px 0 0; }
  .facts dt { font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .facts dd { margin: 4px 0 0; font-size: 15px; color: var(--fog-3); }
  .links { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; }
  .prose { padding-block: 24px; }
  .prose :global(h2) { font-size: clamp(1.6rem, 2.6vw, 2.1rem); margin: 48px 0 16px; }
  .prose :global(p), .prose :global(li) { color: var(--fog-2); max-width: 66ch; }
  .prose :global(ul) { padding-left: 1.2em; display: grid; gap: 10px; }
  .prose :global(li::marker) { color: var(--ember); }
  .prose :global(strong) { color: var(--moon); font-weight: 600; }
  .prose :global(img) { display: block; width: 100%; height: auto; margin: 28px 0; border-radius: 14px; border: 1px solid var(--wire); box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5); }
  .prose :global(p:has(> img)) { max-width: none; }
  .prose :global(code) { font-family: var(--mono); font-size: 0.9em; background: var(--asphalt); border: 1px solid var(--wire); padding: 2px 6px; border-radius: 6px; color: var(--light); }
  .next { display: flex; flex-direction: column; gap: 8px; margin-top: 64px; padding: 32px; border-radius: var(--radius); border: 1px solid var(--wire); background: var(--asphalt); text-decoration: none; transition: border-color 0.3s; }
  .next:hover { border-color: rgba(255, 246, 224, 0.35); }
  .next-title { font-family: var(--serif); font-size: 1.6rem; }
</style>
