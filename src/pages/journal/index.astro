---
import Base from '../../layouts/Base.astro';
import { href } from '../../data/site';
import { getEntries, formatDate } from '../../data/journal';

const entries = await getEntries();
---
<Base title="Journal" description="Notes and reflections by Narada Kasun on work, learning, photography and the small details." solidHeader>
  <section class="wrap journal">
    <p class="eyebrow">Journal</p>
    <h1>Written down.</h1>
    <p class="lede">Notes on work, learning to code, photography and the small things worth remembering.</p>

    {entries.length === 0 ? (
      <p class="empty muted">The first entry is on its way.</p>
    ) : (
      <ol class="entries">
        {entries.map((e) => (
          <li>
            <a href={href(`/journal/${e.id}/`)}>
              <time datetime={e.data.date.toISOString()}>{formatDate(e.data.date)}</time>
              <strong>{e.data.title}</strong>
              {e.data.summary && <span class="muted">{e.data.summary}</span>}
            </a>
          </li>
        ))}
      </ol>
    )}
    <p class="rss"><a href={href('/rss.xml')}>Subscribe via RSS</a></p>
  </section>
</Base>

<style>
  .journal { max-width: 860px; display: flex; flex-direction: column; gap: 18px; padding-block: 72px 120px; }
  .journal h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 1.02; }
  .entries { list-style: none; margin: 32px 0 0; padding: 0; border-top: 1px solid var(--wire); }
  .entries a { display: grid; gap: 6px; padding: 26px 0; border-bottom: 1px solid var(--wire); text-decoration: none; transition: padding 0.3s var(--ease); }
  .entries a:hover { padding-left: 10px; }
  .entries time { font-family: var(--mono); font-size: 13px; color: var(--ember); }
  .entries strong { font-family: var(--serif); font-size: 1.6rem; font-weight: 600; }
  .empty { margin-top: 32px; }
  .rss { margin-top: 24px; font-size: 14px; }
  .rss a { color: var(--fog-3); text-underline-offset: 4px; }
</style>
