---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { profile, href } from '../../data/site';
import { getEntries, formatDate } from '../../data/journal';

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const site = Astro.site!;
const homeUrl = new URL(href('/'), site).href;
const url = new URL(href(`/journal/${entry.id}/`), site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.summary,
    datePublished: d.date.toISOString(),
    url,
    author: { '@type': 'Person', '@id': `${homeUrl}#person`, name: profile.name, url: homeUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: 'Journal', item: new URL(href('/journal/'), site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base title={d.title} description={d.summary ?? `A journal entry by ${profile.name}.`} type="article" schema={schema} solidHeader>
  <article class="wrap entry">
    <a class="back" href={href('/journal/')}>← Journal</a>
    <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
    <h1>{d.title}</h1>
    {d.summary && <p class="lede">{d.summary}</p>}
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .entry { max-width: 760px; display: flex; flex-direction: column; gap: 16px; padding-block: 56px 120px; }
  .back { font-family: var(--mono); font-size: 13px; color: var(--fog-3); text-underline-offset: 4px; margin-bottom: 24px; }
  time { font-family: var(--mono); font-size: 13px; color: var(--ember); }
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.06; }
  .prose { padding-top: 24px; font-size: 1.1rem; }
  .prose :global(p), .prose :global(li) { color: var(--fog-2); max-width: 66ch; margin: 0 0 1.2em; }
  .prose :global(h2) { font-size: 1.8rem; margin: 40px 0 14px; }
  .prose :global(img) { display: block; width: min(100%, 440px); height: auto; border-radius: 16px; margin: 32px 0; box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55); }
  .prose :global(blockquote) { margin: 24px 0; padding-left: 20px; border-left: 2px solid var(--ember); font-family: var(--serif); font-size: 1.3rem; color: var(--moon); }
  .prose :global(a) { color: var(--light); text-underline-offset: 4px; }
</style>
